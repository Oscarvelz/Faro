<?xml version="1.0" encoding="utf-8"?>
<!-- 1.3.408: the picker's honest preview for "Faro · Panel" — the dashboard's
     silhouette (head, hero, its named sections) with real labels and the
     hidden-amounts face wherever a figure would go. No invented figure,
     category, rate or date. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg_xl" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="22dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/w_lamp" android:importantForAccessibility="no" />
            <TextView style="@style/W.Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:textSize="15dp" android:fontFamily="sans-serif-medium" android:text="@string/w_panel_label" />
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_in" android:src="@drawable/w_ic_plus" android:padding="7dp" android:contentDescription="@string/w_add_in" />
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="10dp" android:background="@drawable/w_btn_out" android:src="@drawable/w_ic_minus" android:padding="7dp" android:contentDescription="@string/w_add_out" />
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="10dp" android:background="@drawable/w_btn_cam" android:src="@drawable/w_ic_cam" android:padding="7dp" android:contentDescription="@string/w_add_cam" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp" android:background="@drawable/w_press">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                <TextView style="@style/W.Fit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="bottom|start" android:paddingBottom="7dp" android:fontFamily="sans-serif" android:textColor="@color/w_muted" android:autoSizeMaxTextSize="18dp" android:textSize="18dp" android:text="@string/w_hidden" />
                <TextView style="@style/W.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:paddingBottom="7dp" android:textSize="14dp" android:textColor="@color/w_muted" android:text="@string/w_left" />
            </LinearLayout>
            <ProgressBar style="@style/W.Bar" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="10dp" android:progressDrawable="@drawable/w_bar_month" android:progress="0" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
                <TextView style="@style/W.Kick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12.5dp" android:text="@string/w_have" />
                <TextView style="@style/W.Fit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp" android:layout_marginStart="6dp" android:autoSizeMaxTextSize="14dp" android:textSize="14dp" android:textColor="@color/w_teal" android:text="• • • •" />
                <TextView style="@style/W.Kick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="12.5dp" android:text="@string/w_spend" />
                <TextView style="@style/W.Fit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp" android:layout_marginStart="6dp" android:autoSizeMaxTextSize="14dp" android:textSize="14dp" android:textColor="@color/w_orange" android:text="• • • •" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
            <TextView style="@style/W.Kick" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12dp" android:fontFamily="sans-serif-medium" android:text="@string/w_six" />
            <TextView style="@style/W.Kick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12dp" android:fontFamily="sans-serif-medium" android:text="@string/w_cats" />
            <TextView style="@style/W.Kick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="12dp" android:fontFamily="sans-serif-medium" android:text="@string/w_due14" />
            <TextView style="@style/W.Kick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="12dp" android:fontFamily="sans-serif-medium" android:text="@string/w_savings" />
            <TextView style="@style/W.Kick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="12dp" android:fontFamily="sans-serif-medium" android:text="@string/w_rate" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <TextView style="@style/W.Fit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp" android:autoSizeMaxTextSize="14dp" android:textSize="14dp" android:text="• • • •" />
            <TextView style="@style/W.Fit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp" android:gravity="end" android:autoSizeMaxTextSize="14dp" android:textSize="14dp" android:textColor="@color/w_purple" android:text="• • • •" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
