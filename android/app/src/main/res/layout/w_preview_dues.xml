<?xml version="1.0" encoding="utf-8"?>
<!-- 1.3.408: the picker's honest preview for "Faro · Vencimientos" — the
     real silhouette (title row + due rows) with the hidden-amounts face
     where a merchant, a day count or an amount would go. No invented due. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingTop="11dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_press">
            <TextView style="@style/W.Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="13dp" android:textColor="@color/w_muted" android:fontFamily="sans-serif-medium" android:text="Vencimientos" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_press">
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/w_dot_muted" android:importantForAccessibility="no" />
            <TextView style="@style/W.Fit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="17dp" android:layout_marginStart="9dp" android:fontFamily="sans-serif" android:autoSizeMaxTextSize="13dp" android:textSize="13dp" android:text="• • • •" />
            <TextView style="@style/W.Num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="58dp" android:layout_marginStart="10dp" android:gravity="end" android:textSize="13dp" android:text="• • • •" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_press">
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/w_dot_muted" android:importantForAccessibility="no" />
            <TextView style="@style/W.Fit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="17dp" android:layout_marginStart="9dp" android:fontFamily="sans-serif" android:autoSizeMaxTextSize="13dp" android:textSize="13dp" android:text="• • • •" />
            <TextView style="@style/W.Num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="58dp" android:layout_marginStart="10dp" android:gravity="end" android:textSize="13dp" android:text="• • • •" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_press">
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/w_dot_muted" android:importantForAccessibility="no" />
            <TextView style="@style/W.Fit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="17dp" android:layout_marginStart="9dp" android:fontFamily="sans-serif" android:autoSizeMaxTextSize="13dp" android:textSize="13dp" android:text="• • • •" />
            <TextView style="@style/W.Num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="58dp" android:layout_marginStart="10dp" android:gravity="end" android:textSize="13dp" android:text="• • • •" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
