<?xml version="1.0" encoding="utf-8"?>
<!-- Lamp + month on the left; + (income, teal) and − (expense, orange) on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="30dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/w_lamp" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/w_lamp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/w_month" style="@style/W.Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="7dp" android:textSize="13dp" android:textColor="@color/w_muted" android:fontFamily="sans-serif-medium" android:text="@string/w_month_sample" />
    <ImageView android:id="@+id/w_add_in" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/w_btn_in" android:src="@drawable/w_ic_plus" android:padding="7dp" android:contentDescription="@string/w_add_in" />
    <ImageView android:id="@+id/w_add_out" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="8dp" android:background="@drawable/w_btn_out" android:src="@drawable/w_ic_minus" android:padding="7dp" android:contentDescription="@string/w_add_out" />
</LinearLayout>
