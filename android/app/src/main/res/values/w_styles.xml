<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="W" />
    <style name="W.Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/w_ink</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
    </style>
    <style name="W.Kick" parent="W.Text">
        <item name="android:textColor">@color/w_muted</item>
        <item name="android:textSize">11dp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="W.Num" parent="W.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="W.Fit" parent="W.Num">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8dp</item>
        <item name="android:autoSizeStepGranularity">0.5dp</item>
    </style>
    <style name="W.Bar" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:indeterminate">false</item>
        <item name="android:indeterminateOnly">false</item>
        <item name="android:max">1000</item>
        <item name="android:minHeight">2dp</item>
        <item name="android:maxHeight">2000dp</item>
        <item name="android:minWidth">2dp</item>
        <item name="android:maxWidth">2000dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
