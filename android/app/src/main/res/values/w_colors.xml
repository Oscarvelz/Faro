<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widgets. Since 1.3.237 «Señal» the widget is ONE register day and night:
     a warm-black pressed plate (the finish Oscar picked for the quick-note card), so this
     file and values-night carry the same values — the plate does not follow the phone's
     day/night, exactly as in the specimen he approved. Teal = money in, orange = money out,
     amber = what is owed / due soon (subtle), purple = savings only; the data colours keep
     their bright register so they read on the dark plate. -->
<resources>
    <color name="w_bg">#16120F</color>
    <color name="w_ink">#F2EAD9</color>
    <color name="w_muted">#A79B88</color>
    <color name="w_line">#1CFFFFFF</color>
    <color name="w_track">#1AFFFFFF</color>
    <color name="w_teal">#3FD6F5</color>
    <color name="w_teal_soft">#263FD6F5</color>
    <color name="w_teal_track">#803FD6F5</color>
    <color name="w_orange">#FF9D2A</color>
    <color name="w_orange_soft">#33FF9D2A</color>
    <color name="w_amber">#FFC23A</color>
    <color name="w_amber_soft">#29FFC23A</color>
    <color name="w_purple">#BA92FD</color>
    <color name="w_purple_soft">#2EBA92FD</color>
    <color name="w_bad">#FF6A5A</color>
    <color name="w_prev">#3DFFFFFF</color>
    <color name="w_press">#1FFFFFFF</color>
    <!-- 1.3.237 «Señal»: the plate tokens — black outer ring / taupe keyline / flat warm body /
         the +/− chips' solid fill and frame. All SOLID (alpha FF): in this language nothing
         carries meaning below full paint. Same values in values-night, by design. -->
    <color name="w_senal_hair">#FF000000</color>
    <color name="w_senal_rim">#FF3A332B</color>
    <color name="w_senal_body">#FF16120F</color>
    <color name="w_senal_chip">#FF241E19</color>
    <color name="w_senal_chip_line">#FF453B31</color>
</resources>
