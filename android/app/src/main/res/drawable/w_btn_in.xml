<?xml version="1.0" encoding="utf-8"?>
<!-- 1.3.237 «Señal»: the + chip as a small solid plate (the card's Cancelar grammar) —
     warm solid fill, taupe frame, square 8dp corners; the glyph keeps the sign colour.
     The ripple stays: it is the tap's answer, tinted with the sign. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/w_teal_soft">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_chip" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/w_senal_chip_line" />
        </shape>
    </item>
</ripple>
