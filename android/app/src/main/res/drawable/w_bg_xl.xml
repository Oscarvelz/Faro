<?xml version="1.0" encoding="utf-8"?>
<!-- 1.3.235 «El cristal»: the widget glass for the tablet panels (w_panel_l / w_panel_xl) —
     same five layers as w_bg, with a weaker brillo: on a very large surface the standard
     sheen would read as fog, not glass. Rim and hairline stay 1dp at every size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_glass_hair" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_glass_rim" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/w_glass_top" android:centerColor="@color/w_glass_mid" android:endColor="@color/w_glass_bot" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315"
                android:startColor="@color/w_glass_brillo_xl" android:centerColor="#00000000" android:endColor="#00000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/w_glass_fall" android:centerColor="#00000000" android:endColor="@color/w_glass_seat" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
