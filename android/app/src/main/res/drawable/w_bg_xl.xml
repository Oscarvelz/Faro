<?xml version="1.0" encoding="utf-8"?>
<!-- 1.3.237 «Señal» for the tablet panels (w_panel_l / w_panel_xl): the same three solid
     layers as w_bg — one language at every size, no sheen to weaken on a large surface. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_hair" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_rim" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_body" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
