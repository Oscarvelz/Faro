<?xml version="1.0" encoding="utf-8"?>
<!-- 1.3.408: the camera chip — the same solid «Señal» plate as + / −
     (w_btn_in / w_btn_out), with a neutral ripple: the camera is neither
     income nor expense, it is a door. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/w_muted">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_chip" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/w_senal_chip_line" />
        </shape>
    </item>
</ripple>
