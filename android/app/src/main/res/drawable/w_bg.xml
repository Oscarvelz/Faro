<?xml version="1.0" encoding="utf-8"?>
<!-- 1.3.237 «Señal»: the widget as a warm-black pressed plate — the same language Oscar
     picked for the quick-note card. Three SOLID layers, no gradient anywhere (nothing to
     band on OLED, nothing that can render differently on his phone): the black outer ring,
     the taupe keyline, the flat warm body. The plate is opaque and reads the same day and
     night, on any wallpaper. Every layer carries its own corners (outer radius minus its
     ring), so no corner thickens. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_hair" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_rim" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_body" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
