<?xml version="1.0" encoding="utf-8"?>
<!-- Phone: 4×2 by default (One UI), resizable from 4×1 to 4×4; 3 h refresh + a midnight tick recount the days left. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp" android:minHeight="100dp"
    android:minResizeWidth="180dp" android:minResizeHeight="40dp"
    android:maxResizeWidth="560dp" android:maxResizeHeight="420dp"
    android:targetCellWidth="4" android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="10800000"
    android:initialLayout="@layout/w_empty"
    android:previewLayout="@layout/w_phone_l"
    android:previewImage="@drawable/w_preview_phone"
    android:description="@string/w_phone_desc"
    android:configure="com.oscarvelz.faro.WidgetConfigActivity" />
