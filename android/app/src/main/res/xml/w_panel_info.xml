<?xml version="1.0" encoding="utf-8"?>
<!-- Tablet: 6×4 by default, a real dashboard; grows to the whole home screen. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="440dp" android:minHeight="260dp"
    android:minResizeWidth="440dp" android:minResizeHeight="260dp"
    android:targetCellWidth="6" android:targetCellHeight="4"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="10800000"
    android:initialLayout="@layout/w_empty"
    android:previewLayout="@layout/w_panel_l"
    android:previewImage="@drawable/w_preview_panel"
    android:description="@string/w_panel_desc" />
