<?xml version="1.0" encoding="utf-8"?>
<!-- 1.3.237 «Señal» (API 31+): the standard widget plate with the launcher's own corner
     language — the outer radius follows @dimen/w_radius (the system widget background
     radius on 31+) and the inner layers take the system's inner radius, so the host's crop
     and the plate agree. Layers and colours as drawable/w_bg. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_hair" />
            <corners android:radius="@dimen/w_radius" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_rim" />
            <corners android:radius="@android:dimen/system_app_widget_inner_radius" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_senal_body" />
            <corners android:radius="@android:dimen/system_app_widget_inner_radius" />
        </shape>
    </item>
</layer-list>
